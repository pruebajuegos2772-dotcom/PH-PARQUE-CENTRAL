# Neon PostgreSQL pooled connection string for local development or Drizzle Kit.
# Copy this file to .env and replace the placeholders. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require"

# Secret used to sign login sessions (minimum 16 characters).
# Generate one with: openssl rand -base64 32
# Copy the same value to Vercel → Project → Settings → Environment Variables.
SESSION_SECRET="cambia-esto-por-un-valor-aleatorio-de-al-menos-16-caracteres"
